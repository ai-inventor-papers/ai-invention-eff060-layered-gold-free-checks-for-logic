\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Consensus AUROC as a function of the number of peer families $k$ on the development set ($n{=}2{,}014$ candidates from 186 sentences with all seven peer families available). Each point averages over 50 random $k$-subsets. Blue solid line: all sentences; orange dashed line: long-sentence tercile. Dotted grey line: full 7-family pool (AUROC 0.784). AUROC rises steeply from $k{=}1$ (0.685) to $k{=}3$ (0.757, 96.6\% of full pool) and gains little thereafter. The long-sentence tercile starts lower and keeps climbing, needing $k{=}5$ families to reach 95\% of its own full-pool value.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:k_families}{{4}{10}{Consensus AUROC as a function of the number of peer families $k$ on the development set ($n{=}2{,}014$ candidates from 186 sentences with all seven peer families available). Each point averages over 50 random $k$-subsets. Blue solid line: all sentences; orange dashed line: long-sentence tercile. Dotted grey line: full 7-family pool (AUROC 0.784). AUROC rises steeply from $k{=}1$ (0.685) to $k{=}3$ (0.757, 96.6\% of full pool) and gains little thereafter. The long-sentence tercile starts lower and keeps climbing, needing $k{=}5$ families to reach 95\% of its own full-pool value}{figure.4}{}}
