\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces AUROC for consensus (aligned) and the disguised Flash-Lite judge per sentence stratum. Left of the dashed line: the four strata of development set\nobreakspace  {}E (CTRL $n{=}386$, L20 $n{=}821$, L25 $n{=}873$, EXC $n{=}606$). On short FOLIO controls consensus has no advantage (CTRL: $\Delta {=}{-}0.07$ $[-0.23, 0.10]$). The gap is significant on L20 ($+0.11$) and largest on exception sentences (EXC: $+0.20$). Right of the dashed line: R\_COMP under the SIG condition (templated long rule sentences, $n{=}1{,}904$), where consensus reaches 0.954 versus the judge's 0.587.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:complexity}{{3}{8}{AUROC for consensus (aligned) and the disguised Flash-Lite judge per sentence stratum. Left of the dashed line: the four strata of development set~E (CTRL $n{=}386$, L20 $n{=}821$, L25 $n{=}873$, EXC $n{=}606$). On short FOLIO controls consensus has no advantage (CTRL: $\Delta {=}{-}0.07$ $[-0.23, 0.10]$). The gap is significant on L20 ($+0.11$) and largest on exception sentences (EXC: $+0.20$). Right of the dashed line: R\_COMP under the SIG condition (templated long rule sentences, $n{=}1{,}904$), where consensus reaches 0.954 versus the judge's 0.587}{figure.3}{}}
