\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of cross-family solver consensus. Given a sentence, $k$ independent LLM families each produce a candidate FOL translation at temperature\nobreakspace  {}0. For each candidate\nobreakspace  {}$c$, Z3 checks pairwise equivalence to every peer translation after vocabulary alignment. The consensus score is the fraction of peers that disagree with\nobreakspace  {}$c$; higher disagreement predicts error.\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Overview of cross-family solver consensus. Given a sentence, $k$ independent LLM families each produce a candidate FOL translation at temperature~0. For each candidate~$c$, Z3 checks pairwise equivalence to every peer translation after vocabulary alignment. The consensus score is the fraction of peers that disagree with~$c$; higher disagreement predicts error.\relax }{figure.caption.2}{}}
