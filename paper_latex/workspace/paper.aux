\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Stratified AUROC of cross-family solver consensus and baseline faithfulness metrics on the held-out development set (2,686 candidate formalizations, 1,822 unfaithful / 864 faithful, 292 sentences). Whiskers are 95\% sentence-clustered bootstrap CIs ($B=2000$). The dashed line marks the pre-registered judge bar (Flash-Lite judge, disguised view, 0.642) and the dotted line marks chance (0.5). Consensus scores highest (0.741) and exceeds the judge bar by $+0.099$ $[0.049, 0.146]$. Adding it to the combined baseline stack raises AUROC by $+0.039$ $[0.021, 0.057]$, so it carries signal the baselines lack.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:main_auroc}{{1}{2}{Stratified AUROC of cross-family solver consensus and baseline faithfulness metrics on the held-out development set (2,686 candidate formalizations, 1,822 unfaithful / 864 faithful, 292 sentences). Whiskers are 95\% sentence-clustered bootstrap CIs ($B=2000$). The dashed line marks the pre-registered judge bar (Flash-Lite judge, disguised view, 0.642) and the dotted line marks chance (0.5). Consensus scores highest (0.741) and exceeds the judge bar by $+0.099$ $[0.049, 0.146]$. Adding it to the combined baseline stack raises AUROC by $+0.039$ $[0.021, 0.057]$, so it carries signal the baselines lack}{figure.1}{}}
